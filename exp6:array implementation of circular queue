#include <stdio.h>
#include <stdlib.h>

#define SIZE 10

int queue[SIZE];
int front = -1, rear = -1;

// Function declarations
void enqueue(int element);
void dequeue();
void display();

int main()
{
    int choice, element;

    while(1)
    {
        printf("\nMenu:\n");
        printf("1. Enqueue\n");
        printf("2. Dequeue\n");
        printf("3. Display\n");
        printf("4. Exit\n");

        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch(choice)
        {
            case 1:
                if((rear + 1) % SIZE == front){
                    printf("Queue is Full!\n");
                    break;
                }

                printf("Enter element: ");
                scanf("%d", &element);

                enqueue(element);
                break;

            case 2:
                dequeue();
                break;

            case 3:
                display();
                break;

            case 4:
                printf("Exiting the program...\n");
                exit(0);

            default:
                printf("Invalid choice!\n");
        }
    }
}

// Enqueue function
void enqueue(int element)
{
    if(front == -1)
        front = rear = 0;
    else
        rear = (rear + 1) % SIZE;

    queue[rear] = element;
    printf("Inserted: %d\n", element);
}

// Dequeue function
void dequeue()
{
    if(front == -1){
        printf("Queue is Empty!\n");
        return;
    }

    printf("Deleted: %d\n", queue[front]);

    if(front == rear)
        front = rear = -1;
    else
        front = (front + 1) % SIZE;
}

// Display function
void display()
{
    if(front == -1){
        printf("Queue is Empty!\n");
        return;
    }

    printf("Queue elements: ");
    int i = front;

    while(1)
    {
        printf("%d ", queue[i]);
        if(i == rear)
            break;
        i = (i + 1) % SIZE;
    }

    printf("\n");
}
