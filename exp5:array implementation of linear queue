#include <stdio.h>
#include <stdlib.h>

#define SIZE 10

int queue[SIZE];
int front = -1, rear = -1;

// Function declarations
void enqueue(int element);
void dequeue();
void display();

int main()
{
    int choice, element;

    while(1)
    {
        printf("\nMenu:\n");
        printf("1. Enqueue\n");
        printf("2. Dequeue\n");
        printf("3. Display\n");
        printf("4. Exit\n");

        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch(choice)
        {
            case 1:
                if(rear == SIZE - 1){
                    printf("Queue is Full!\n");
                    break;
                }

                printf("Enter element: ");
                scanf("%d", &element);

                enqueue(element);
                break;

            case 2:
                dequeue();
                break;

            case 3:
                display();
                break;

            case 4:
                printf("Exiting the program...\n");
                exit(0);

            default:
                printf("Invalid choice!\n");
        }
    }
}

// Enqueue function
void enqueue(int element)
{
    if(front == -1)
        front = 0;

    queue[++rear] = element;
    printf("Inserted: %d\n", element);
}

// Dequeue function
void dequeue()
{
    if(front == -1 || front > rear){
        printf("Queue is Empty!\n");
        return;
    }

    printf("Deleted: %d\n", queue[front++]);
}

// Display function
void display()
{
    if(front == -1 || front > rear){
        printf("Queue is Empty!\n");
        return;
    }

    printf("Queue elements: ");
    for(int i = front; i <= rear; i++)
        printf("%d ", queue[i]);

    printf("\n");
}
